# Copie locale : cp .env.example .env, puis fournir ces variables au processus.
# Ne jamais mettre de valeur réelle/secrète dans ce fichier ni dans Git.

# Développement : laisser DEBUG non défini ou true. Production : false.
DJANGO_DEBUG=true
# Obligatoire pour les secrets de production; générer une valeur aléatoire forte.
# DJANGO_SECRET_KEY=
# Hôtes séparés par des virgules; localhost est utilisé si non défini en développement.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production uniquement : URL PostgreSQL, jamais SQLite en production.
# Encoder les caractères réservés du mot de passe dans l'URL; sslmode=require recommandé.
# DJANGO_DATABASE_URL=postgresql://USER:PERCENT_ENCODED_PASSWORD@HOST:5432/DBNAME?sslmode=require
# DJANGO_DB_CONN_MAX_AGE=60

# Production : backend de cache partagé (ex. Redis accessible par tous les workers).
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=rediss://USER:PASSWORD@REDIS_HOST:6379/0
# DJANGO_CACHE_KEY_PREFIX=dunia

# Activer ces options de sécurité en production uniquement derrière HTTPS correctement configuré.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# Origines complètes uniquement si le proxy/service utilise une origine séparée.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com
# Définir l'en-tête proxy seulement si le proxy le nettoie et le fixe lui-même.
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# HSTS : laisser à 0 tant que HTTPS et tous les sous-domaines ne sont pas validés.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false

# Répertoires persistants; le privé doit être hors de MEDIA_ROOT et jamais servi publiquement.
# DJANGO_PRIVATE_MEDIA_ROOT=/srv/dunia-private

# Développement : backend console. Production : SMTP TLS ou backend tiers.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=Dunia <noreply@example.com>
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false
# DJANGO_EMAIL_TIMEOUT=10
